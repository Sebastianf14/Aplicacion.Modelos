@model Aplicacion.MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="auth-card">
                    <div class="auth-card-header">
                        <h3><i class="fas fa-user-plus"></i> Crear Nueva Cuenta</h3>
                    </div>
                    <div class="auth-card-body">
                        
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle"></i> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <!-- Información Personal -->
                            <h5 class="mb-3 text-primary">
                                <i class="fas fa-user"></i> Información Personal
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label">
                                        <i class="fas fa-user"></i> Nombre *
                                    </label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Tu nombre" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label">
                                        <i class="fas fa-user"></i> Apellido *
                                    </label>
                                    <input asp-for="LastName" class="form-control" placeholder="Tu apellido" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Credenciales de Acceso -->
                            <h5 class="mb-3 text-primary mt-4">
                                <i class="fas fa-key"></i> Credenciales de Acceso
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope"></i> Email *
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="ejemplo@correo.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label">
                                        <i class="fas fa-lock"></i> Contraseña *
                                    </label>
                                    <input asp-for="Password" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">
                                        <i class="fas fa-lock"></i> Confirmar Contraseña *
                                    </label>
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repetir contraseña" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Tipo de Usuario -->
                            <h5 class="mb-3 text-primary mt-4">
                                <i class="fas fa-user-tag"></i> Tipo de Usuario
                            </h5>

                            <div class="mb-4">
                                <label asp-for="Role" class="form-label">
                                    <i class="fas fa-user-tag"></i> Selecciona tu tipo de cuenta *
                                </label>
                                <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
                                    <option value="">-- Selecciona una opción --</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>

                                <!-- Descripción de roles -->
                                <div class="form-text mt-3">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="border rounded p-2 text-center">
                                                <i class="fas fa-headphones text-success"></i>
                                                <strong>Usuario</strong><br>
                                                <small>Explorar y escuchar música</small>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="border rounded p-2 text-center">
                                                <i class="fas fa-music text-primary"></i>
                                                <strong>Artista</strong><br>
                                                <small>Subir y gestionar tu música</small>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="border rounded p-2 text-center">
                                                <i class="fas fa-cog text-warning"></i>
                                                <strong>Administrador</strong><br>
                                                <small>Gestión completa del sistema</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Botón de registro -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-user-plus"></i> Crear Mi Cuenta
                                </button>
                            </div>
                        </form>

                        <hr class="mt-4">
                        <div class="text-center">
                            <p class="mb-0">
                                ¿Ya tienes cuenta?
                                <a asp-area="Identity" asp-page="/Account/Login" class="text-decoration-none">
                                    <i class="fas fa-sign-in-alt"></i> Inicia sesión aquí
                                </a>
                            </p>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/soniko-login-register.css" />


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Mostrar/ocultar descripción de roles
        $('#Role').on('change', function() {
            const selectedRole = $(this).val();
            $('.role-description').hide();
            if(selectedRole) {
                $(`.role-${selectedRole}`).show();
            }
        });
    </script>
}