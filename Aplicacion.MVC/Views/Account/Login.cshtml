@model Aplicacion.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="auth-card">
                    <div class="auth-card-header">
                        <h3><i class="fas fa-sign-in-alt"></i> Iniciar Sesión</h3>
                    </div>
                    <div class="auth-card-body">


                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            <input asp-for="@ViewData["ReturnUrl"]" type="hidden" />
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="ejemplo@correo.com" autocomplete="username" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">
                                    <i class="fas fa-lock"></i> Contraseña
                                </label>
                                <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="Tu contraseña" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                <label asp-for="RememberMe" class="form-check-label">
                                    Recordarme en este dispositivo
                                </label>
                            </div>

                            <div class="d-grid gap-2 mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                                </button>
                            </div>
                        </form>

                        <hr>

                        <!-- Enlaces adicionales -->
                        <div class="row text-center">
                            <div class="text-center mt-3">
                                <a asp-action="ForgotPassword" class="text-decoration-none">
                                    <i class="fas fa-question-circle"></i> ¿Olvidaste tu contraseña?
                                </a>
                            </div>
                            <div class="col-12">
                                <a asp-controller="Account" asp-action="Register" class="text-decoration-none">
                                    <i class="fas fa-user-plus"></i> Registrarse como nuevo usuario
                                </a>
                            </div>
                        </div>

                        <!-- Información adicional -->
                        <div class="mt-4 p-3 bg-light rounded">
                            <h6 class="text-muted">
                                <i class="fas fa-info-circle"></i> ¿Nuevo en SonikoMusic?
                            </h6>
                            <p class="text-muted small mb-0">
                                Crea una cuenta para subir tu música, crear playlists y disfrutar de todas las funciones.
                            </p>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/soniko-login-register.css" />




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Focus automático en email al cargar
        $(document).ready(function() {
            $('#Email').focus();
        });

        // Animación suave para mensajes de error
        $('.text-danger').hide().fadeIn('slow');
    </script>
        

}