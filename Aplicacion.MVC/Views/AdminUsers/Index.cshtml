@model IEnumerable<Aplicacion.MVC.Models.Admin.UserListViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fas fa-users"></i> Gestión de Usuarios</h1>
        <p>Administra todos los usuarios del sistema</p>
    </div>

    <!-- Estadísticas generales -->
    <div class="admin-stats-grid">
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="stat-label">Total Usuarios</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🎨</div>
            <div class="stat-number">@ViewBag.TotalArtists</div>
            <div class="stat-label">Artistas</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👤</div>
            <div class="stat-number">@ViewBag.TotalRegularUsers</div>
            <div class="stat-label">Usuarios Regulares</div>
        </div>
    </div>

    <!-- Filtros de navegación -->
    <div class="filter-tabs">
        <a href="@Url.Action("Index")" class="filter-tab active">
            <i class="fas fa-list"></i> Todos
        </a>
        <a href="@Url.Action("Artists")" class="filter-tab">
            <i class="fas fa-palette"></i> Solo Artistas
        </a>
        <a href="@Url.Action("RegularUsers")" class="filter-tab">
            <i class="fas fa-user"></i> Solo Usuarios
        </a>
    </div>

    <!-- Lista de usuarios -->
    <div class="admin-section">
        <h4><i class="fas fa-table"></i> Lista de Usuarios</h4>
        
        @if (Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Registro</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar-info">
                                            @user.FirstName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="user-details">
                                            <h6>@user.FirstName @user.LastName</h6>
                                            <small>@user.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-@user.Role">
                                        @switch (user.Role)
                                        {
                                            case "artists":
                                                <i class="fas fa-palette"></i> <text>Artista</text>
                                                break;
                                            case "admins":
                                                <i class="fas fa-shield-alt"></i> <text>Admin</text>
                                                break;
                                            default:
                                                <i class="fas fa-user"></i> <text>Usuario</text>
                                                break;
                                        }
                                    </span>
                                </td>
                                <td>
                                    @user.RegistrationDate.ToString("dd/MM/yyyy")
                                    <br><small>@user.RegistrationDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> Activo
                                    </span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = user.Id })" class="btn-admin btn-view">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = user.Id })" class="btn-admin btn-edit" style="background: rgba(244, 67, 54, 0.8);">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; opacity: 0.7;">
                <i class="fas fa-users" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <h5>No hay usuarios registrados</h5>
            </div>
        }
    </div>
</div>
