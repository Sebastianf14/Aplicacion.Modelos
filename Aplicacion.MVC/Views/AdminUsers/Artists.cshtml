@model IEnumerable<Aplicacion.MVC.Models.Admin.UserListViewModel>
@{
    ViewData["Title"] = "Gestión de Artistas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin.css" />


<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fas fa-palette"></i> Gestión de Artistas</h1>
        <p>Administra todos los artistas y su contenido</p>
    </div>

    <!-- Estadísticas de artistas -->
    <div class="admin-stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🎨</div>
            <div class="stat-number">@ViewBag.TotalArtists</div>
            <div class="stat-label">Total Artistas</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🎵</div>
            <div class="stat-number">@ViewBag.TotalSongs</div>
            <div class="stat-label">Canciones Subidas</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📀</div>
            <div class="stat-number">@ViewBag.TotalAlbums</div>
            <div class="stat-label">Álbumes Creados</div>
        </div>
    </div>

    <!-- Filtros de navegación -->
    <div class="filter-tabs">
        <a href="@Url.Action("Index")" class="filter-tab">
            <i class="fas fa-list"></i> Todos
        </a>
        <a href="@Url.Action("Artists")" class="filter-tab active">
            <i class="fas fa-palette"></i> Solo Artistas
        </a>
        <a href="@Url.Action("RegularUsers")" class="filter-tab">
            <i class="fas fa-user"></i> Solo Usuarios
        </a>
    </div>

    <!-- Lista de artistas -->
    <div class="admin-section">
        <h4><i class="fas fa-users"></i> Lista de Artistas</h4>

        @if (Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Artista</th>
                            <th>Contenido</th>
                            <th>Registro</th>
                            <th>Actividad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var artist in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar-info">
                                            @artist.FirstName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="user-details">
                                            <h6>@artist.FirstName @artist.LastName</h6>
                                            <small>@artist.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 15px;">
                                        <span><i class="fas fa-music"></i> @artist.MusicCount canciones</span>
                                        <span><i class="fas fa-compact-disc"></i> @artist.AlbumCount álbumes</span>
                                    </div>
                                </td>
                                <td>
                                    @artist.RegistrationDate.ToString("dd/MM/yyyy")
                                    <br><small>@artist.RegistrationDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @if (artist.MusicCount > 0)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fas fa-clock"></i> Sin contenido
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = artist.Id })" class="btn-admin btn-view">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = artist.Id })" class="btn-admin btn-edit" style="background: rgba(244, 67, 54, 0.8);">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; opacity: 0.7;">
                <i class="fas fa-palette" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <h5>No hay artistas registrados</h5>
            </div>
        }
    </div>
</div>
