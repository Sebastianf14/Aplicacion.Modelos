@model IEnumerable<Aplicacion.MVC.Models.Admin.UserListViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fas fa-user"></i> Gestión de Usuarios</h1>
        <p>Administra usuarios regulares y sus suscripciones</p>
    </div>

    <!-- Estadísticas de usuarios -->
    <div class="admin-stats-grid">
        <div class="stat-card">
            <div class="stat-icon">👤</div>
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="stat-label">Total Usuarios</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <div class="stat-number">@ViewBag.TotalPlaylists</div>
            <div class="stat-label">Playlists Creadas</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💎</div>
            <div class="stat-number">@ViewBag.PremiumUsers</div>
            <div class="stat-label">Usuarios Premium</div>
        </div>
    </div>

    <!-- Filtros de navegación -->
    <div class="filter-tabs">
        <a href="@Url.Action("Index")" class="filter-tab">
            <i class="fas fa-list"></i> Todos
        </a>
        <a href="@Url.Action("Artists")" class="filter-tab">
            <i class="fas fa-palette"></i> Solo Artistas
        </a>
        <a href="@Url.Action("RegularUsers")" class="filter-tab active">
            <i class="fas fa-user"></i> Solo Usuarios
        </a>
    </div>

    <!-- Lista de usuarios -->
    <div class="admin-section">
        <h4><i class="fas fa-users"></i> Lista de Usuarios Regulares</h4>

        @if (Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Plan</th>
                            <th>Actividad</th>
                            <th>Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar-info">
                                            @user.FirstName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="user-details">
                                            <h6>@user.FirstName @user.LastName</h6>
                                            <small>@user.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge @(user.SubscriptionPlan == "Gratuito" ? "status-inactive" : "status-premium")">
                                        @if (user.SubscriptionPlan == "Gratuito")
                                        {
                                            <i class="fas fa-user"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-crown"></i>
                                        }
                                        @user.SubscriptionPlan
                                    </span>
                                </td>
                                <td>
                                    <div style="font-size: 0.85rem;">
                                        <div><i class="fas fa-list"></i> @user.PlaylistCount playlists</div>
                                        <div><i class="fas fa-download"></i> @user.DownloadCount descargas</div>
                                    </div>
                                </td>
                                <td>
                                    @user.RegistrationDate.ToString("dd/MM/yyyy")
                                    <br><small>@user.RegistrationDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = user.Id })" class="btn-admin btn-view">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = user.Id })" class="btn-admin btn-edit" style="background: rgba(244, 67, 54, 0.8);">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; opacity: 0.7;">
                <i class="fas fa-user" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <h5>No hay usuarios regulares registrados</h5>
            </div>
        }
    </div>
</div>

