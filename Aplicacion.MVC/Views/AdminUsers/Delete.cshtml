@model Aplicacion.MVC.Models.Admin.UserDeleteViewModel
@{
    ViewData["Title"] = $"Eliminar - {Model.FirstName} {Model.LastName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-container">
    <div class="admin-header">
        <h1><i class="fas fa-exclamation-triangle" style="color: #ff6b6b;"></i> Eliminar Usuario</h1>
        <p>¿Estás seguro de que deseas eliminar este @(Model.Role == "artists" ? "artista" : "usuario")?</p>
    </div>

    <div class="admin-section" style="max-width: 600px; margin: 0 auto;">
        <!-- Información del usuario a eliminar -->
        <div class="details-card" style="margin-bottom: 30px;">
            <div class="user-info" style="justify-content: center; margin-bottom: 20px;">
                <div class="user-avatar-info" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    @Model.FirstName.Substring(0, 1).ToUpper()
                </div>
                <div class="user-details" style="margin-left: 15px;">
                    <h4 style="margin: 0;">@Model.FirstName @Model.LastName</h4>
                    <p style="margin: 0; opacity: 0.8;">@Model.Email</p>
                    <span class="status-badge status-@Model.Role">
                        @(Model.Role == "artists" ? "Artista" : "Usuario")
                    </span>
                </div>
            </div>

            <ul class="details-list">
                <li>
                    <span>Fecha de registro:</span>
                    <strong>@Model.RegistrationDate.ToString("dd/MM/yyyy")</strong>
                </li>
                @if (Model.Role == "artists")
                {
                    <li>
                        <span>Canciones a eliminar:</span>
                        <strong style="color: #ff6b6b;">@Model.MusicCount</strong>
                    </li>
                    <li>
                        <span>Álbumes a eliminar:</span>
                        <strong style="color: #ff6b6b;">@Model.AlbumCount</strong>
                    </li>
                }
                else
                {
                    <li>
                        <span>Playlists a eliminar:</span>
                        <strong style="color: #ff6b6b;">@Model.PlaylistCount</strong>
                    </li>
                    <li>
                        <span>Descargas a eliminar:</span>
                        <strong style="color: #ff6b6b;">@Model.DownloadCount</strong>
                    </li>
                }
            </ul>
        </div>

        <!-- Advertencia -->
        <div style="background: rgba(244, 67, 54, 0.2); border: 2px solid #f44336; border-radius: 15px; padding: 20px; margin-bottom: 30px;">
            <h5 style="color: #ff6b6b; margin-bottom: 15px;">
                <i class="fas fa-exclamation-triangle"></i> ¡Advertencia!
            </h5>
            <p style="margin: 0;">
                Esta acción <strong>NO SE PUEDE DESHACER</strong>. Se eliminará permanentemente:
            </p>
            <ul style="margin: 10px 0; padding-left: 20px;">
                <li>El usuario y toda su información personal</li>
                @if (Model.Role == "artists")
                {
                    <li>Todas sus canciones y álbumes</li>
                    <li>Sus seguidores y seguidos</li>
                }
                else
                {
                    <li>Todas sus playlists y descargas</li>
                    <li>Su suscripción y favoritos</li>
                }
                <li>Toda la actividad relacionada (follows, favoritos, etc.)</li>
            </ul>
        </div>

        <!-- Formulario de confirmación -->
        <form asp-action="DeleteConfirmed" method="post" style="text-align: center;">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn-admin"
                    style="background: linear-gradient(45deg, #f44336, #d32f2f); padding: 15px 30px; font-size: 1.1rem; margin-right: 15px;"
                    onclick="return confirm('¿ESTÁS COMPLETAMENTE SEGURO? Esta acción eliminará PERMANENTEMENTE al usuario y TODO su contenido.')">
                <i class="fas fa-trash"></i> SÍ, ELIMINAR PERMANENTEMENTE
            </button>

            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn-admin btn-view" style="padding: 15px 30px; font-size: 1.1rem;">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </form>
    </div>
</div>