@model Aplicacion.Modelos.Implementations.Download
@{
    ViewData["Title"] = "Detalles de Descarga";
}

<link rel="stylesheet" href="~/css/downloads.css" />

<div class="downloads-container">
    <div class="downloads-header">
        <h1><i class="fas fa-info-circle"></i> Detalles de Descarga</h1>
    </div>

    <div class="downloads-grid" style="max-width: 600px;">
        <div class="download-card">
            <div class="download-info">
                <h3>@Model.Music?.Title</h3>
                <p><i class="fas fa-user"></i> <strong>Artista:</strong> @Model.Music?.Artist?.FirstName @Model.Music?.Artist?.LastName</p>
                <p><i class="fas fa-music"></i> <strong>Género:</strong> @Model.Music?.Genre</p>
                <p><i class="fas fa-clock"></i> <strong>Duración:</strong> @Model.Music?.Duration</p>
                <p><i class="fas fa-calendar"></i> <strong>Fecha de descarga:</strong> @Model.DownloadDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p>
                    <i class="fas fa-info"></i> <strong>Estado:</strong>
                    <span class="status-badge status-@(Model.Status.ToString().ToLower())">
                        @Model.Status
                    </span>
                </p>
                @if (!string.IsNullOrEmpty(Model.LocalFilePath))
                {
                    <p><i class="fas fa-folder"></i> <strong>Ubicación:</strong> @Model.LocalFilePath</p>
                }
            </div>
            <div class="download-actions">
                <a href="/files/@Model.Music?.FilePath" download class="btn-download">
                    <i class="fas fa-download"></i> Descargar Nuevamente
                </a>
                <a href="@Url.Action("Index")" class="btn-download">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
                <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn-download btn-danger-download">
                    <i class="fas fa-trash"></i> Eliminar del Historial
                </a>
            </div>
        </div>
    </div>
</div>