
@model Aplicacion.Modelos.Suscription.UserSubscription
@{
    ViewData["Title"] = "Pago Exitoso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- El resto de la vista queda igual -->

<link rel="stylesheet" href="~/css/subscriptions.css" />

<div class="subscriptions-container">
    <div class="subscriptions-header">
        <h1><i class="fas fa-check-circle" style="color: #4caf50;"></i> ¡Pago Exitoso!</h1>
        <p>Tu suscripción ha sido activada correctamente</p>
    </div>

    <div class="payment-container" style="text-align: center;">
        <div class="payment-summary" style="background: rgba(76, 175, 80, 0.2); border: 2px solid #4caf50;">
            <h2><i class="fas fa-crown" style="color: #ffd700;"></i> Plan @Model.SubscriptionPlan?.Name</h2>
            <p><strong>Activo desde:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
            <p><strong>Válido hasta:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</p>
            <p><strong>Método de pago:</strong> @Model.PaymentMethod</p>
        </div>

        <div style="margin: 30px 0;">
            <h3>🎉 ¡Bienvenido a SonikoMusic Premium!</h3>
            <p>Ya puedes disfrutar de todos los beneficios de tu plan:</p>

            <ul class="plan-features" style="max-width: 400px; margin: 20px auto; text-align: left;">
                @if (Model.SubscriptionPlan?.AllowDownloads == true)
                {
                    <li>
                        <span class="feature-text">✅ Descargas ilimitadas</span>
                    </li>
                }
                @if (Model.SubscriptionPlan?.AllowOfflineMode == true)
                {
                    <li>
                        <span class="feature-text">✅ Modo offline</span>
                    </li>
                }
                <li>
                    <span class="feature-text">✅ @(Model.SubscriptionPlan?.MaxPlaylists == -1 ? "Playlists ilimitadas" : $"{Model.SubscriptionPlan?.MaxPlaylists} playlists")</span>
                </li>
                @if (Model.SubscriptionPlan?.HasAds == false)
                {
                    <li>
                        <span class="feature-text">✅ Sin publicidad</span>
                    </li>
                }
            </ul>
        </div>

        <div class="subscription-actions">
            <a href="@Url.Action("Search", "Musics")" class="btn-subscribe" style="width: 60%;">
                <i class="fas fa-music"></i> Explorar Música
            </a>
            <a href="@Url.Action("Index")" class="btn-subscription btn-change" style="width: 35%;">
                <i class="fas fa-cog"></i> Mi Suscripción
            </a>
        </div>

        <p style="margin-top: 30px; opacity: 0.8;">
            📧 Hemos enviado un comprobante de pago a tu email.<br>
            Si tienes dudas, contacta nuestro soporte.
        </p>
    </div>
</div>
