@model Aplicacion.MVC.Models.PaymentViewModel
@{
    ViewData["Title"] = "Procesar Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/subscriptions.css" />

<div class="subscriptions-container">
    <div class="subscriptions-header">
        <h1><i class="fas fa-credit-card"></i> Procesar Pago</h1>
        <p>Completa tu suscripción de forma segura</p>
    </div>

    <div class="payment-container">
        <div class="payment-summary">
            <h3><i class="fas fa-crown"></i> Plan @Model.PlanName</h3>
            <p>Duración: @Model.Months mes(es)</p>
            <h2 style="color: #4ecdc4; margin: 15px 0;">Total: $@Model.TotalAmount</h2>
        </div>

        <form asp-action="ProcessPayment" method="post" class="payment-form">
            <input asp-for="PlanId" type="hidden" />
            <input asp-for="Months" type="hidden" />
            <input asp-for="TotalAmount" type="hidden" />
            <input asp-for="PlanName" type="hidden" />

            <div class="form-group">
                <label asp-for="CardHolderName">Nombre del Titular</label>
                <input asp-for="CardHolderName" class="form-control" placeholder="Juan Pérez" />
                <span asp-validation-for="CardHolderName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CardNumber">Número de Tarjeta</label>
                <input asp-for="CardNumber" class="form-control" placeholder="1234567890123456" maxlength="19" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
                <small style="opacity: 0.7; margin-top: 5px; display: block;">
                    
                </small>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ExpiryMonth">Mes</label>
                    <select asp-for="ExpiryMonth" class="form-control">
                        <option value="">MM</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@i.ToString("D2")</option>
                        }
                    </select>
                    <span asp-validation-for="ExpiryMonth" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ExpiryYear">Año</label>
                    <select asp-for="ExpiryYear" class="form-control">
                        <option value="">YYYY</option>
                        @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 10; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="ExpiryYear" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CVV">CVV</label>
                <input asp-for="CVV" class="form-control" placeholder="123" maxlength="4" />
                <span asp-validation-for="CVV" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email de Confirmación</label>
                <input asp-for="Email" class="form-control" placeholder="tu@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <small style="opacity: 0.7; margin-top: 5px; display: block;">
                    📧 Te enviaremos el comprobante a este email
                </small>
            </div>

            <div class="subscription-actions" style="margin-top: 40px;">
                <button type="submit" class="btn-subscribe" style="width: 60%;">
                    <i class="fas fa-lock"></i> Pagar $@Model.TotalAmount
                </button>
                <a href="@Url.Action("Plans")" class="btn-subscription btn-cancel" style="width: 35%;">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        
        document.getElementById('CardNumber').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 19) value = value.substr(0, 19); // ✅ Cambiar de 16 a 19
            e.target.value = value;
        });

        // Solo números en CVV
        document.getElementById('CVV').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');
            e.target.value = value;
        });
    </script>
}
