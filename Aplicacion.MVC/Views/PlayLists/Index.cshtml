@using Aplicacion.MVC
@using Aplicacion.MVC.Models
@using Aplicacion.Modelos
@model IEnumerable<Aplicacion.Modelos.Playlist>
@{
    ViewData["Title"] = "Playlists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        @if (User.IsInRole("admins"))
        {
            @:<i class="fas fa-list"></i> Todas las Playlists
        }
        else
        {
            @:<i class="fas fa-list"></i> Mis Playlists
        }
    </h1>
    @if (User.IsInRole("users"))
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Crear Playlist
        </a>
    }
</div>

<div class="row">
    @foreach (var playlist in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@playlist.Name</h5>
                    <p class="card-text">@playlist.Description</p>
                    <div class="d-flex justify-content-between text-muted small">
                        <span>
                            <i class="fas fa-calendar"></i> @playlist.CreatedDate.ToString("dd/MM/yyyy")
                        </span>
                        <span>
                            @if (playlist.IsPublic)
                            {
                                @:<i class="fas fa-globe text-success"></i> Pública
                            }
                            else
                            {
                                @:<i class="fas fa-lock text-warning"></i> Privada
                            }
                        </span>
                    </div>
                    <div class="btn-group mt-2" role="group">
                        <a asp-action="Details" asp-route-id="@playlist.Id" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                        @if (User.IsInRole("users"))
                        {
                            <a asp-action="Edit" asp-route-id="@playlist.Id" class="btn btn-outline-warning btn-sm">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        }
                        @if (User.IsInRole("users") || User.IsInRole("admins"))
                        {
                            <a asp-action="Delete" asp-route-id="@playlist.Id" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash"></i> Eliminar
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <i class="fas fa-list fa-3x text-muted"></i>
        <p class="mt-3 text-muted">No hay playlists disponibles</p>
        @if (User.IsInRole("users"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus"></i> Crear tu primera playlist
            </a>
        }
    </div>
}